<pages:WizardPage x:Class="AxiomateInstaller.Pages.EnvCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AxiomateInstaller.Pages"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6,12">
            <TextBlock Text="{DynamicResource Env_Header}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="{DynamicResource Env_Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Env_Lbl_Os}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="OsText"  Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="OsBadge" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Env_Lbl_Arch}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ArchText"  Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="ArchBadge" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Env_Lbl_Git}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="GitText"  Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <CheckBox  Grid.Column="2" x:Name="GitInstallChk" Content="{DynamicResource Env_GitInstall}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Env_Lbl_Py}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="PyText"  Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <CheckBox  Grid.Column="2" x:Name="PyInstallChk"  Content="{DynamicResource Env_PyInstall}" VerticalAlignment="Center" Checked="PyInstallChk_Toggle" Unchecked="PyInstallChk_Toggle"/>
                    </Grid>

                    <Border x:Name="MirrorBlock" Margin="0,12,0,0" Padding="12" Background="#F0F5F6" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                        <StackPanel>
                            <CheckBox x:Name="MirrorEnableChk" Content="{DynamicResource Env_Mirror_Box_Header}" IsChecked="True" Foreground="{StaticResource Text}" Checked="MirrorEnable_Toggle" Unchecked="MirrorEnable_Toggle"/>
                            <StackPanel x:Name="MirrorOptionsPanel" Margin="22,8,0,0">
                                <RadioButton x:Name="MirrorTsinghua" GroupName="Mirror" Content="{DynamicResource Env_Mirror_Tsinghua}" IsChecked="True" Margin="0,2"/>
                                <RadioButton x:Name="MirrorAliyun"   GroupName="Mirror" Content="{DynamicResource Env_Mirror_Aliyun}"   Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="WarningText" Foreground="{StaticResource Danger}" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</pages:WizardPage>

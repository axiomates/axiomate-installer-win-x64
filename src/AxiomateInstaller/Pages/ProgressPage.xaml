<pages:WizardPage x:Class="AxiomateInstaller.Pages.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AxiomateInstaller.Pages"
      Background="Transparent">
    <Grid Margin="6,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="正在安装" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        <TextBlock Grid.Row="1" x:Name="StepText" Margin="0,8,0,8" Foreground="{StaticResource Muted}"/>
        <ProgressBar Grid.Row="2" x:Name="Bar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource BrandPrimary}"/>

        <Border Grid.Row="3" Margin="0,16,0,0" Background="#101820" CornerRadius="6">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                <TextBlock x:Name="LogText" FontFamily="Consolas, ui-monospace" FontSize="12" Foreground="#E5F3F2" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</pages:WizardPage>

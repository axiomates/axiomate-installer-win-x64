<pages:WizardPage x:Class="AxiomateInstaller.Pages.InstallPathPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AxiomateInstaller.Pages"
      Background="Transparent">
    <StackPanel Margin="6,12">
        <TextBlock Text="{DynamicResource Path_Header}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        <TextBlock Text="{DynamicResource Path_Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="{DynamicResource Path_Lbl_Target}" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="PathBox" Padding="8,6" FontSize="14"/>
                    <Button  Grid.Column="1" Content="{DynamicResource Btn_Browse}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>
                <TextBlock x:Name="HintText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="WarnText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Danger}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Path_FooterNote}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
</pages:WizardPage>

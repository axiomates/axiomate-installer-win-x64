<pages:WizardPage x:Class="AxiomateInstaller.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AxiomateInstaller.Pages"
      Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- language selector — only on this page -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
            <TextBlock Text="{DynamicResource Welcome_LangLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="LangZh" GroupName="Lang" Content="{DynamicResource Welcome_LangZh}" Margin="0,0,8,0" Checked="LangZh_Checked"/>
            <RadioButton x:Name="LangEn" GroupName="Lang" Content="{DynamicResource Welcome_LangEn}" Checked="LangEn_Checked"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="6,12">
            <TextBlock Text="{DynamicResource Welcome_Header}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="SubtitleText" Margin="0,6,0,18" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Welcome_TasksTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                    <TextBlock Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="22">
                        <Run Text="{DynamicResource Welcome_Task1}"/><LineBreak/>
                        <Run Text="{DynamicResource Welcome_Task2}"/><LineBreak/>
                        <Run Text="{DynamicResource Welcome_Task3}"/><LineBreak/>
                        <Run Text="{DynamicResource Welcome_Task4}"/><LineBreak/>
                        <Run Text="{DynamicResource Welcome_Task5}"/><LineBreak/>
                        <Run Text="{DynamicResource Welcome_Task6}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource Welcome_Footer}" Margin="0,18,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- busy overlay shown while uninstalling a prior install -->
        <Border x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="#CCFFFFFF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                             Foreground="{StaticResource BrandPrimary}" Background="{StaticResource Line}" BorderThickness="0"/>
                <TextBlock x:Name="BusyText" Margin="0,14,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource Text}" Text="{DynamicResource Welcome_Uninstalling}"/>
            </StackPanel>
        </Border>
    </Grid>
</pages:WizardPage>

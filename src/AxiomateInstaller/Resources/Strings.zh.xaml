<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- chrome -->
    <sys:String x:Key="App_Title">Axiomate Installer</sys:String>
    <sys:String x:Key="App_HeaderTitle">Axiomate Installer</sys:String>
    <sys:String x:Key="Btn_Back">上一步</sys:String>
    <sys:String x:Key="Btn_Next">下一步</sys:String>
    <sys:String x:Key="Btn_Cancel">取消</sys:String>
    <sys:String x:Key="Btn_Browse">浏览...</sys:String>
    <sys:String x:Key="Btn_Finish">完成</sys:String>
    <sys:String x:Key="Btn_StartInstall">开始安装</sys:String>
    <sys:String x:Key="Btn_Continue">继续</sys:String>
    <sys:String x:Key="Footer_About">指南</sys:String>
    <sys:String x:Key="Confirm_ExitTitle">退出 Axiomate Installer</sys:String>
    <sys:String x:Key="Confirm_ExitBody">确定要退出安装器吗？</sys:String>

    <!-- welcome -->
    <sys:String x:Key="Welcome_Subtitle_Format">安装器版本 {0} · 包含 Axiomate {1}。下一步将检测您的运行环境。</sys:String>
    <sys:String x:Key="Welcome_Header">欢迎使用 Axiomate</sys:String>
    <sys:String x:Key="Welcome_PageSubtitle">欢迎</sys:String>
    <sys:String x:Key="Welcome_TasksTitle">安装器将完成以下事情:</sys:String>
    <sys:String x:Key="Welcome_Task1">• 检查 Windows 11 / x64 / Git / Python 环境</sys:String>
    <sys:String x:Key="Welcome_Task2">• 缺失时使用内置 Git 2.54 与 Python 3.12 静默安装 (Git 必装, Python 可选)</sys:String>
    <sys:String x:Key="Welcome_Task3">• 释放 Axiomate 到您选择的目录, 并把它加入系统 PATH</sys:String>
    <sys:String x:Key="Welcome_Task4">• 启用 PowerShell 脚本执行 (RemoteSigned) 与 Windows 开发人员模式</sys:String>
    <sys:String x:Key="Welcome_Task5">• 可选: 快速配置常见模型</sys:String>
    <sys:String x:Key="Welcome_Task6">• 可选: 创建工作区与桌面/开始菜单快捷方式</sys:String>
    <sys:String x:Key="Welcome_Footer">点击「下一步」继续。</sys:String>
    <sys:String x:Key="Welcome_Uninstalling">正在卸载已安装的 Axiomate，请稍候...</sys:String>
    <sys:String x:Key="Welcome_LangLabel">语言 / Language</sys:String>
    <sys:String x:Key="Welcome_LangZh">中文</sys:String>
    <sys:String x:Key="Welcome_LangEn">English</sys:String>

    <!-- env check -->
    <sys:String x:Key="Env_Header">环境检查</sys:String>
    <sys:String x:Key="Env_PageSubtitle">环境检查</sys:String>
    <sys:String x:Key="Env_Subtitle">确认 Windows 版本与 Git/Python 是否就绪。</sys:String>
    <sys:String x:Key="Env_Detecting">正在检测...</sys:String>
    <sys:String x:Key="Env_Lbl_Os">操作系统</sys:String>
    <sys:String x:Key="Env_Lbl_Arch">架构</sys:String>
    <sys:String x:Key="Env_Lbl_Git">Git</sys:String>
    <sys:String x:Key="Env_Lbl_Py">Python</sys:String>
    <sys:String x:Key="Env_GitInstall">使用内置 Git 2.54 安装</sys:String>
    <sys:String x:Key="Env_GitInstallRequired">使用内置 Git 2.54 安装 (必装)</sys:String>
    <sys:String x:Key="Env_PyInstall">使用内置 Python 3.12 安装 (可选)</sys:String>
    <sys:String x:Key="Env_GitInstalled_Format">已安装 ({0})</sys:String>
    <sys:String x:Key="Env_PyInstalled_Format">已安装 ({0})</sys:String>
    <sys:String x:Key="Env_GitNotFound">未检测到 Git</sys:String>
    <sys:String x:Key="Env_PyNotFound">未检测到 Python</sys:String>
    <sys:String x:Key="Env_Mirror_Box_Header">配置 pip 镜像源 (推荐, 国内网络下载更快)</sys:String>
    <sys:String x:Key="Env_Mirror_Tsinghua">清华大学 TUNA  ·  pypi.tuna.tsinghua.edu.cn</sys:String>
    <sys:String x:Key="Env_Mirror_Aliyun">阿里云           ·  mirrors.aliyun.com</sys:String>
    <sys:String x:Key="Env_Warn_NeedWin11">需要 Windows 11 (build 22000) 或更高版本。无法继续。</sys:String>
    <sys:String x:Key="Env_Warn_NeedX64">需要 64 位 (x64) Windows。无法继续。</sys:String>
    <sys:String x:Key="Env_Block_GitTitle">环境检查</sys:String>
    <sys:String x:Key="Env_Block_GitBody">Git 未达到要求, 且您取消了内置 Git 安装。请勾选或先自行安装。</sys:String>
    <sys:String x:Key="Env_Block_PyTitle">环境检查</sys:String>
    <sys:String x:Key="Env_Block_PyBody">Python 未达到要求, 且您取消了内置 Python 安装。请勾选或先自行安装。</sys:String>

    <!-- install path -->
    <sys:String x:Key="Path_Header">安装位置</sys:String>
    <sys:String x:Key="Path_PageSubtitle">选择安装位置</sys:String>
    <sys:String x:Key="Path_Subtitle">安装前会先清空目标目录。请选择普通用户可写目录。</sys:String>
    <sys:String x:Key="Path_Lbl_Target">目标目录</sys:String>
    <sys:String x:Key="Path_Hint_Empty">目录可用。</sys:String>
    <sys:String x:Key="Path_Hint_NonEmpty">提示: 该目录非空, 安装时会被清空。</sys:String>
    <sys:String x:Key="Path_FooterNote">注意: 安装器会清空目标目录后再写入。为避免破坏系统稳定性, Windows / Program Files / ProgramData 等关键目录及其子目录都会被禁止选择。</sys:String>
    <sys:String x:Key="Path_BadTitle">目录不可用</sys:String>
    <sys:String x:Key="Path_ConfirmWipeTitle">确认清空</sys:String>
    <sys:String x:Key="Path_ConfirmWipeBody_Format">目录 "{0}" 非空。
安装器将清空该目录后再写入。继续？</sys:String>
    <sys:String x:Key="Path_PickerTitle">选择 Axiomate 安装目录</sys:String>
    <sys:String x:Key="Path_PriorInstallTitle">检测到已安装的 Axiomate</sys:String>
    <sys:String x:Key="Path_PriorInstallBody_Format">检测到已安装的 Axiomate ({0})。继续将先卸载旧版本(清理 PATH、快捷方式与旧目录), 再安装新版本。是否继续？</sys:String>

    <!-- DirGuard -->
    <sys:String x:Key="DG_Empty">请填写安装路径。</sys:String>
    <sys:String x:Key="DG_Unparseable_Format">路径无法解析: {0}</sys:String>
    <sys:String x:Key="DG_Root">不能直接安装到驱动器根目录。</sys:String>
    <sys:String x:Key="DG_Invalid">路径包含非法字符或不是绝对路径。</sys:String>
    <sys:String x:Key="DG_Reserved_Format">不能安装到用户保留目录: {0}</sys:String>
    <sys:String x:Key="DG_Protected_Format">不能使用受保护目录或其子目录, 选择此类位置可能破坏系统稳定性或导致权限问题: {0}</sys:String>
    <sys:String x:Key="DG_AxiomateConfig_Format">不能使用 Axiomate 配置目录或其子目录, 该目录固定用于保存配置: {0}</sys:String>
    <sys:String x:Key="DG_NoLeaf">请提供具体的子目录, 不要直接装在根目录。</sys:String>

    <!-- options -->
    <sys:String x:Key="Opt_Header">安装选项</sys:String>
    <sys:String x:Key="Opt_PageSubtitle">安装选项</sys:String>
    <sys:String x:Key="Opt_Subtitle">这些选项可以省略；不勾选时也能正常使用 axiomate 命令。</sys:String>
    <sys:String x:Key="Opt_ModelChk">快速模型配置</sys:String>
    <sys:String x:Key="Opt_ModelHint">勾选后下一步可以选择模型并填入 API Key, 安装时会写入 ~/.axiomate.json。不勾选也可以继续安装；启动 Axiomate 后可按首次引导添加模型, 或手动编辑 ~/.axiomate.json 添加其他模型。</sys:String>
    <sys:String x:Key="Opt_ClearConfigChk">清空 Axiomate 配置目录</sys:String>
    <sys:String x:Key="Opt_ClearConfigHint">Axiomate 目前处于测试阶段, 版本升级可能不兼容旧数据文件。如遇异常可勾选此项清空 ~/.axiomate/ 目录。默认不勾选；勾选前如有重要内容(如 skill 等)请先备份。</sys:String>
    <sys:String x:Key="Opt_ClearConfigJsonChk">清空模型配置 (.axiomate.json)</sys:String>
    <sys:String x:Key="Opt_ClearConfigJsonHint">删除 ~/.axiomate.json, 避免版本升级带来的兼容性问题。默认不勾选；如有自定义模型或想保留当前配置, 请先备份。快速配置会覆盖该文件, 因此会强制勾选此项。</sys:String>
    <sys:String x:Key="Opt_BypassPermChk">默认开启 bypass permissions 模式</sys:String>
    <sys:String x:Key="Opt_BypassPermHint">关闭时 Axiomate 会按默认权限策略询问确认；开启后会写入 ~/.axiomate/settings.json，让 AI 可以不再逐次询问权限而自动执行代码。</sys:String>
    <sys:String x:Key="Opt_WorkspaceChk">创建默认工作区与快捷方式</sys:String>
    <sys:String x:Key="Opt_WorkspaceHint">勾选后将在桌面与开始菜单创建 Axiomate 快捷方式, 双击直接以工作区目录为当前目录启动 Axiomate TUI, 适合初次接触此类软件的用户。</sys:String>
    <sys:String x:Key="Opt_WorkspaceLabel">工作区目录</sys:String>
    <sys:String x:Key="Opt_FooterNote">注: 注册到系统 PATH 是默认行为, 不可关闭。</sys:String>
    <sys:String x:Key="Opt_PickerTitle">选择 Axiomate 工作区目录</sys:String>
    <sys:String x:Key="Opt_BadWorkspaceTitle">工作区</sys:String>
    <sys:String x:Key="Opt_BadWorkspaceBody_Empty">请填写工作区目录。</sys:String>
    <sys:String x:Key="Opt_BadWorkspaceBody_Invalid">工作区路径不合法。</sys:String>
    <sys:String x:Key="Opt_BadWorkspaceBody_SameAsInstall">工作区目录不能和安装目录相同。请选择另一个文件夹。</sys:String>
    <sys:String x:Key="Opt_BadWorkspaceBody_OverlapsInstall">工作区目录不能和安装目录相同, 也不能互相包含。请选择另一个文件夹。</sys:String>

    <!-- model -->
    <sys:String x:Key="Model_Header">模型配置</sys:String>
    <sys:String x:Key="Model_PageSubtitle">模型配置</sys:String>
    <sys:String x:Key="Model_Subtitle">选择默认模型并填入 API Key。</sys:String>
    <sys:String x:Key="Model_Lbl_Site">模型站点</sys:String>
    <sys:String x:Key="Model_SiteDeepseek">DeepSeek 官方  ·  api.deepseek.com</sys:String>
    <sys:String x:Key="Model_SiteZhipu">智谱 BigModel  ·  open.bigmodel.cn</sys:String>
    <sys:String x:Key="Model_Lbl_Model">主要模型</sys:String>
    <sys:String x:Key="Model_Item_Pro">deepseek-v4-pro    (高质量, 强推理)</sys:String>
    <sys:String x:Key="Model_Item_Flash">deepseek-v4-flash  (轻量, 高速度)</sys:String>
    <sys:String x:Key="Model_Item_Glm52Coding">glm-5.2    (Coding Plan, 更便宜)</sys:String>
    <sys:String x:Key="Model_Item_Glm47Coding">glm-4.7    (Coding Plan, 更便宜)</sys:String>
    <sys:String x:Key="Model_Item_Glm52">glm-5.2    (通用端点)</sys:String>
    <sys:String x:Key="Model_Item_Glm47">glm-4.7    (通用端点)</sys:String>
    <sys:String x:Key="Model_Lbl_ApiKey">API Key</sys:String>
    <sys:String x:Key="Model_ShowKey">显示</sys:String>
    <sys:String x:Key="Model_Footer_BeforeLink">可在 </sys:String>
    <sys:String x:Key="Model_Footer_Link_Deepseek">DeepSeek 官方平台</sys:String>
    <sys:String x:Key="Model_Footer_Link_Zhipu">智谱 BigModel 平台</sys:String>
    <sys:String x:Key="Model_Footer_AfterLink">获取 API Key，创建 API key 后请复制使用，不可包含 * 字符。</sys:String>
    <sys:String x:Key="Model_BadKeyTitle">模型配置</sys:String>
    <sys:String x:Key="Model_BadKeyBody">请填写 API Key。</sys:String>

    <!-- progress -->
    <sys:String x:Key="Progress_Header">正在安装</sys:String>
    <sys:String x:Key="Progress_PageSubtitle">正在安装</sys:String>
    <sys:String x:Key="Progress_Step_Format">步骤 {0}/{1} : {2}</sys:String>
    <sys:String x:Key="Progress_Done">安装完成！</sys:String>
    <sys:String x:Key="Progress_Failed">安装失败</sys:String>
    <sys:String x:Key="Progress_FailDialogTitle">Axiomate 安装失败</sys:String>
    <sys:String x:Key="Progress_FailDialogBody_Format">{0}

详细日志: {1}

点击「是」打开日志文件。</sys:String>
    <sys:String x:Key="Progress_UnexpectedFailure_Format">未预期的错误: {0}</sys:String>

    <!-- progress step titles -->
    <sys:String x:Key="Step_Extract">正在解压安装资源</sys:String>
    <sys:String x:Key="Step_GitInstall">正在安装 Git for Windows</sys:String>
    <sys:String x:Key="Step_PyInstall">正在安装 Python 3.12</sys:String>
    <sys:String x:Key="Step_PipMirror">配置 pip 镜像源</sys:String>
    <sys:String x:Key="Step_Deploy">部署 Axiomate 到目标目录</sys:String>
    <sys:String x:Key="Step_Path">注册系统 PATH</sys:String>
    <sys:String x:Key="Step_WinTune">启用 PowerShell 脚本执行与开发人员模式</sys:String>
    <sys:String x:Key="Step_Model">写入 Axiomate 模型配置</sys:String>
    <sys:String x:Key="Step_ClearConfig">正在清空配置目录</sys:String>
    <sys:String x:Key="Step_ClearConfigJson">正在清空模型配置</sys:String>
    <sys:String x:Key="Step_BypassPerm">写入 bypass permissions 权限配置</sys:String>
    <sys:String x:Key="Step_Workspace">创建工作区与快捷方式</sys:String>
    <sys:String x:Key="Step_Uninst">注册卸载器</sys:String>

    <!-- finish -->
    <sys:String x:Key="Finish_Header">安装完成</sys:String>
    <sys:String x:Key="Finish_PageSubtitle">安装完成</sys:String>
    <sys:String x:Key="Finish_Detail_Format">Axiomate 已安装到 {0}。系统 PATH 已更新。</sys:String>
    <sys:String x:Key="Finish_NextStepTitle">下一步建议</sys:String>
    <sys:String x:Key="Finish_HintWithWorkspace">桌面与开始菜单已创建 Axiomate 快捷方式。双击即可在工作区目录打开 Axiomate TUI。
若快捷方式不可用, 可在新终端中输入 axiomate 启动。</sys:String>
    <sys:String x:Key="Finish_HintNoWorkspace">请重新打开终端窗口让 PATH 生效, 然后输入 axiomate 即可启动。</sys:String>
    <sys:String x:Key="Finish_LaunchBtn">启动 Axiomate</sys:String>

    <!-- engine errors -->
    <sys:String x:Key="Err_Distmissing_Format">内部错误: dist 目录不存在 {0}</sys:String>
    <sys:String x:Key="Err_GitFail_Format">Git 安装失败 (退出码 {0})。请检查日志了解详情。</sys:String>
    <sys:String x:Key="Err_PyCancel">用户取消了 Python 安装。</sys:String>
    <sys:String x:Key="Err_PyFatal">Python 安装时遇到致命错误 (退出码 1603)。可能因为目标目录被占用、磁盘空间不足或权限问题。</sys:String>
    <sys:String x:Key="Err_PyFail_Format">Python 安装失败 (退出码 {0})。请检查日志了解详情。</sys:String>
    <sys:String x:Key="Err_StartProc_Format">无法启动进程: {0}</sys:String>
    <sys:String x:Key="Err_Reg_PathOpenFail">无法打开注册表项 HKLM Environment (需要管理员权限)。</sys:String>
    <sys:String x:Key="Err_Reg_UninstFail">无法创建注册表项 Uninstall\Axiomate。</sys:String>
    <sys:String x:Key="Err_Cfg_NoHome">无法解析用户 Home 目录。</sys:String>
    <sys:String x:Key="Err_Cfg_TmplMissing_Format">找不到内置模板: {0}</sys:String>
    <sys:String x:Key="Err_Lnk_NoCom">无法访问 IShellLink COM 接口。</sys:String>
    <sys:String x:Key="Err_Lnk_NoInst">无法创建 IShellLink 实例。</sys:String>

    <!-- payload extractor -->
    <sys:String x:Key="Err_Pl_GitMissing">Git installer payload missing from embedded resources.</sys:String>
    <sys:String x:Key="Err_Pl_PyMissing">Python installer payload missing from embedded resources.</sys:String>
    <sys:String x:Key="Err_Pl_UninstMissing">Uninstaller payload missing from embedded resources.</sys:String>
    <sys:String x:Key="Err_Pl_DistMissing">Axiomate dist payload missing from embedded resources. Run build.ps1 first.</sys:String>
    <sys:String x:Key="Err_Pl_ResourceMissing_Format">Embedded resource missing: {0}</sys:String>

    <!-- generic dialogs -->
    <sys:String x:Key="Dlg_Err_DispatcherTitle">界面线程异常</sys:String>
    <sys:String x:Key="Dlg_Err_DomainTitle">应用域异常</sys:String>
    <sys:String x:Key="Dlg_Err_TaskTitle">后台任务异常</sys:String>
    <sys:String x:Key="Dlg_Err_Body_Format">{0}: {1}

详细信息已写入日志, 可在弹窗中查看。</sys:String>
    <sys:String x:Key="Dlg_Err_TitleSuffix">Axiomate 安装器</sys:String>
</ResourceDictionary>

<Window x:Class="AxiomateInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Title}" Height="560" Width="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC"
        FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header banner -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Resources/axiomate-logo.png" Width="40" Height="40" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App_HeaderTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="VersionBadge" Grid.Column="2" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content host -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent" Margin="22,18,22,0"/>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <Hyperlink x:Name="AboutLink" Click="AboutLink_Click" Foreground="{StaticResource Muted}" TextDecorations="None">
                        <Run Text="{DynamicResource Footer_About}"/>
                    </Hyperlink>
                    <Run Foreground="{StaticResource Muted}" Text="  ·  "/>
                    <Hyperlink x:Name="WebsiteLink" Click="WebsiteLink_Click" Foreground="#2563EB">
                        <Run Text="http://axiomate.net/docs/install/windows/"/>
                    </Hyperlink>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackBtn"   Content="{DynamicResource Btn_Back}"   Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BackBtn_Click"/>
                    <Button x:Name="NextBtn"   Content="{DynamicResource Btn_Next}"   Style="{StaticResource PrimaryButton}"   Margin="0,0,8,0" Click="NextBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="{DynamicResource Btn_Cancel}" Style="{StaticResource SecondaryButton}" Click="CancelBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

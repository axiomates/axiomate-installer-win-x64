{
  "models": {
    "deepseek-v4-pro": {
      "model": "deepseek-v4-pro",
      "name": "DeepSeek V4 Pro",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 384000,
      "supportsImages": false,
      "thinking": {
        "enabled": true,
        "effort": "high"
      },
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "{{API_KEY}}",
      "modelTemplate": "openai-chat-deepseek-v4p"
    },
    "deepseek-v4-flash": {
      "model": "deepseek-v4-flash",
      "name": "DeepSeek V4 Flash",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 384000,
      "supportsImages": false,
      "thinking": {
        "enabled": true,
        "effort": "high"
      },
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "{{API_KEY}}",
      "modelTemplate": "openai-chat-deepseek-v4p"
    }
  },
  "model": {
    "defaultRoute": "deepseek-v4-pro-main",
    "routes": {
      "deepseek-v4-pro-main": {
        "primary": "deepseek-v4-pro",
        "fallbackChain": [
          "deepseek-v4-flash"
        ],
        "recoveryProfile": "main-agent",
        "allowActions": [
          "retry_same_model",
          "adapt_request",
          "switch_model"
        ],
        "switchModelOn": [
          "rate_limit",
          "overloaded",
          "timeout",
          "connection",
          "server_error",
          "malformed_response",
          "responses_null_output",
          "model_not_found"
        ]
      }
    }
  },

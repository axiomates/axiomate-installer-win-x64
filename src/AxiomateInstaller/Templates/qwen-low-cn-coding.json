{
  "models": {
    "qwen3.6-plus": {
      "model": "qwen3.6-plus",
      "name": "Qwen3.6 Plus",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 65536,
      "supportsImages": false,
      "thinking": {
        "enabled": true
      },
      "baseUrl": "https://coding.dashscope.aliyuncs.com/v1",
      "apiKey": "{{API_KEY}}"
    },
    "qwen3.6-flash": {
      "model": "qwen3.6-flash",
      "name": "Qwen3.6 Flash",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 65536,
      "supportsImages": false,
      "thinking": {
        "enabled": false
      },
      "baseUrl": "https://coding.dashscope.aliyuncs.com/v1",
      "apiKey": "{{API_KEY}}"
    }
  },
  "model": {
    "defaultRoute": "qwen-low-coding-main",
    "routes": {
      "qwen-low-coding-main": {
        "primary": "qwen3.6-plus",
        "fallbackChain": [
          "qwen3.6-flash"
        ],
        "recoveryProfile": "main-agent",
        "allowActions": [
          "retry_same_model",
          "adapt_request",
          "switch_model"
        ],
        "switchModelOn": [
          "rate_limit",
          "overloaded",
          "timeout",
          "connection",
          "server_error",
          "malformed_response",
          "responses_null_output",
          "model_not_found"
        ]
      }
    }
  }
}

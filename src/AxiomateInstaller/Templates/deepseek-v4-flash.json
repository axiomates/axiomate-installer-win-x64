{
  "models": {
    "deepseek-v4-flash": {
      "model": "deepseek-v4-flash",
      "name": "DeepSeek V4 Flash",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 384000,
      "supportsImages": false,
      "thinking": {
        "enabled": true,
        "effort": "high"
      },
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "{{API_KEY}}",
      "modelTemplate": "openai-chat-deepseek-v4p"
    }
  },
  "model": {
    "defaultRoute": "deepseek-v4-flash-main",
    "routes": {
      "deepseek-v4-flash-main": {
        "primary": "deepseek-v4-flash",
        "fallbackChain": [],
        "recoveryProfile": "main-agent",
        "allowActions": [
          "retry_same_model",
          "adapt_request"
        ],
        "switchModelOn": []
      }
    }
  }
}

{
  "models": {
    "mimo-v2.5": {
      "model": "mimo-v2.5",
      "name": "MiMo V2.5",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 131072,
      "supportsImages": true,
      "thinking": {
        "enabled": true
      },
      "baseUrl": "https://api.xiaomimimo.com/v1",
      "apiKey": "{{API_KEY}}"
    }
  },
  "model": {
    "defaultRoute": "mimo-std-main",
    "routes": {
      "mimo-std-main": {
        "primary": "mimo-v2.5",
        "fallbackChain": [],
        "recoveryProfile": "main-agent",
        "allowActions": [
          "retry_same_model",
          "adapt_request"
        ],
        "switchModelOn": []
      }
    }
  }
}

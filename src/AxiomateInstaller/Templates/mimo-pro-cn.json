{
  "models": {
    "mimo-v2.5-pro": {
      "model": "mimo-v2.5-pro",
      "name": "MiMo V2.5 Pro",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 131072,
      "supportsImages": false,
      "thinking": {
        "enabled": true
      },
      "baseUrl": "https://api.xiaomimimo.com/v1",
      "apiKey": "{{API_KEY}}"
    },
    "mimo-v2.5": {
      "model": "mimo-v2.5",
      "name": "MiMo V2.5",
      "protocol": "openai-chat",
      "contextWindow": 1000000,
      "maxOutputTokens": 131072,
      "supportsImages": true,
      "thinking": {
        "enabled": true
      },
      "baseUrl": "https://api.xiaomimimo.com/v1",
      "apiKey": "{{API_KEY}}"
    }
  },
  "model": {
    "defaultRoute": "mimo-pro-main",
    "routes": {
      "mimo-pro-main": {
        "primary": "mimo-v2.5-pro",
        "fallbackChain": [
          "mimo-v2.5"
        ],
        "recoveryProfile": "main-agent",
        "allowActions": [
          "retry_same_model",
          "adapt_request",
          "switch_model"
        ],
        "switchModelOn": [
          "rate_limit",
          "overloaded",
          "timeout",
          "connection",
          "server_error",
          "malformed_response",
          "responses_null_output",
          "model_not_found"
        ]
      }
    }
  }
}
